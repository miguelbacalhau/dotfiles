# Brewfile — packages required by these dotfiles (macOS).
# Install with: brew bundle --file=Brewfile   (run by ./install.sh)

# --- CLI tools ---
brew "neovim"     # editor (config: neovim/ -> ~/.config/nvim)
brew "tmux"       # terminal multiplexer (config: tmux/ -> ~/.config/tmux)
brew "starship"   # shell prompt (config: zsh/starship.toml)
brew "fzf"        # fuzzy finder (sourced from brew in zsh/.zshrc)
brew "fd"         # fast file finder (FZF_DEFAULT_COMMAND in zsh/fzf.zsh)
brew "ripgrep"    # fast grep, used by neovim/telescope + general use
brew "git"        # version control
brew "rustup"     # rust toolchain manager (keg-only; PATH set in zsh/.zshrc)

# --- GUI apps & fonts ---
cask "ghostty"                  # terminal (config: ghostty/ -> ~/.config/ghostty)
cask "font-monaspice-nerd-font" # "MonaspiceNe Nerd Font" used by ghostty/config
